# ==============================================================================
# ÁREA NOBRE — AMBIENTE DE DESENVOLVIMENTO (area-nobre-dev)
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env dentro da pasta area-nobre-dev.
# 2. Preencha as credenciais obtidas no painel do seu projeto Supabase "area-nobre-dev".
# 3. NUNCA insira as credenciais do banco de produção aqui.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL Supabase - Projeto area-nobre-dev)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase > Project Settings > Database > Connection string > URI
# Transaction Pooler (porta 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[DEV_PROJECT_REF]:[DEV_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Pooler ou Direct Connection (porta 5432) para migrations Prisma
DIRECT_URL="postgresql://postgres.[DEV_PROJECT_REF]:[DEV_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (Projeto area-nobre-dev)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase > Project Settings > API
SUPABASE_URL="https://[DEV_PROJECT_REF].supabase.co"

# Obtenha em: Supabase > Project Settings > API > service_role (secret)
SUPABASE_SECRET_KEY="sb_secret_dev_..."

# Nome do bucket criado no Storage do projeto area-nobre-dev
SUPABASE_STORAGE_BUCKET="area-nobre-media"

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO E SESSÃO LOCAL
# ------------------------------------------------------------------------------
# Chave de segurança para assinatura do cookie de sessão local (pode ser gerada aleatoriamente)
AUTH_SECRET="chave-secreta-exclusiva-para-ambiente-de-desenvolvimento-local-32-chars"

# ------------------------------------------------------------------------------
# 4. URLs E NOMES DE AMBIENTE
# ------------------------------------------------------------------------------
APP_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Área Nobre (Dev)"

# Identificador explícito de homologação (opcional, para ambiente de testes/homologação Vercel):
# Quando configurado como 'homologation', ativa o banner visual de testes e cabeçalhos X-Robots-Tag: noindex.
# Em desenvolvimento local comum e em produção comercial, deixar vazio ou não definir.
# APP_ENV="homologation"
# NEXT_PUBLIC_APP_ENV="homologation"

# ------------------------------------------------------------------------------
# 5. MAPAS E GEOBASE
# ------------------------------------------------------------------------------
GEOBASE_API_KEY=""
NEXT_PUBLIC_SATELLITE_PROVIDER="esri"
