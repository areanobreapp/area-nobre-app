generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("BROKER") // "BROKER" | "ADMIN"
  status       String       @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  profile      BrokerProfile?

  properties              Property[]    @relation("CreatedProperties")
  responsibleProperties   Property[]    @relation("ResponsibleProperties")
  developments            Development[] @relation("CreatedDevelopments")
  responsibleDevelopments Development[] @relation("ResponsibleDevelopments")
  clients                 Client[]
  searches                Search[]      @relation("CreatedSearches")
  responsibleSearches     Search[]      @relation("ResponsibleSearches")
  propertyShares          PropertyShare[]
  legalAcceptances        LegalAcceptance[]
  propertyAuthorizations  PropertyAuthorization[]
  createdBuildings        Building[]              @relation("CreatedBuildings")
  waitlists               PropertyWaitlist[]      @relation("BrokerWaitlists")
  disputes                PropertyDispute[]       @relation("BrokerDisputes")
  priceHistories          PhysicalPropertyPriceHistory[] @relation("PriceHistoryAuthor")
  priceRevisionsRequested PriceRevisionRequest[]         @relation("PriceRevisionsRequested")
  priceRevisionsDecided   PriceRevisionRequest[]         @relation("PriceRevisionsDecided")
  updatedPhysicalPrices   PhysicalProperty[]             @relation("PhysicalPropertyPriceUpdater")
  locationContributions   BuildingLocationContribution[] @relation("BrokerLocationContributions")
  decidedLocationContributions BuildingLocationContribution[] @relation("DecidedLocationContributions")
  decidedBuildingGeos     Building[]                     @relation("BuildingGeoAdminDecider")
  createdBuildingBoundaries    Building[]                     @relation("BuildingBoundaryCreatedBy")
  uploadedBuildingCoverImages  Building[]                     @relation("BuildingCoverImageUploadedBy")
  boundaryContributions        BuildingBoundaryContribution[] @relation("BrokerBoundaryContributions")
  decidedBoundaryContributions BuildingBoundaryContribution[] @relation("DecidedBoundaryContributions")
  imageContributions           BuildingImageContribution[]    @relation("BrokerImageContributions")
  decidedImageContributions    BuildingImageContribution[]    @relation("DecidedImageContributions")
  createdLandParcels           LandParcel[]                   @relation("LandParcelCreatedBy")
  createdCompanies             Company[]                      @relation("CreatedCompanies")
}

model BrokerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commercialName String?
  phone          String?
  creci          String?
  tagline        String?
  bio            String?
  city           String?
  avatarUrl      String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Client {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  searches  Search[]
  propertyShares PropertyShare[]
}

model Property {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation("CreatedProperties", fields: [userId], references: [id], onDelete: Cascade)
  responsibleBrokerId String?
  responsibleBroker   User?           @relation("ResponsibleProperties", fields: [responsibleBrokerId], references: [id], onDelete: SetNull)
  title               String
  internalCode  String?
  propertyType  String          // Apartamento, Casa, Terreno, Comercial, Galpão, Rural, Outro
  purpose       String          // Venda, Locação
  status        String          @default("Disponível") // Disponível, Reservado, Vendido/Alugado, Inativo
  price         Float
  privateArea   Float?
  totalArea     Float?
  bedrooms      Int             @default(0)
  suites        Int             @default(0)
  bathrooms     Int             @default(0)
  parkingSpaces Int             @default(0)
  description   String?
  internalNotes String?
  
  // Localização
  address       String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipcode       String?
  latitude      Float?
  longitude     Float?

  // Delimitação do terreno (opcional)
  boundary      String?
  boundaryArea  Float?

  // Semântica de dormitórios e banheiros (Fase 5.0.1)
  otherBedrooms       Int?            // Outros quartos (além das suítes)
  otherBathrooms      Int?            // Outros banheiros (além das suítes)

  // Vagas padronizadas (Pontos 14, 17 e 28 / Fase 1 Bloco 2)
  coveredParkingSpaces   Int?         // Vagas cobertas
  uncoveredParkingSpaces Int?         // Vagas descobertas

  // Banheiros específicos (Pontos 14, 17 e 28 / Fase 1 Bloco 2)
  socialBathrooms        Int?         // Banheiros sociais (com área de banho)
  lavabos                Int?         // Lavabos (sem área de banho)

  // Áreas adicionais
  builtArea              Float?       // Área construída (m²) - principalmente casas

  // Áreas adicionais
  landArea            Float?          // Área do terreno documental (m²)

  // Negociação
  acceptsExchange     Boolean?        // Aceita permuta? (Sim / Não / null)
  exchangeNotes       String?         // Observações da permuta

  // Casa
  isRegistered        Boolean?        // Averbada? (Sim / Não / null)

  // Características Casa / Apartamento
  hasPool             Boolean?        // Piscina
  hasGym              Boolean?        // Academia
  furniture           String?         // Mobília: "Completa" | "Semi" | "Não" | null
  hasBarbecue         Boolean?        // Churrasqueira
  registryNumber      String?         // Número da matrícula

  // Apartamento específico
  hasPartyHall        Boolean?        // Salão de festas
  hasElevator         Boolean?        // Elevador
  isPenthouse         Boolean?        // Cobertura
  hasPetSpace         Boolean?        // Espaço pet
  floor               Int?            // Andar

  // Terreno específico
  isCorner            Boolean?        // Esquina?
  inGatedCommunity    Boolean?        // Condomínio fechado?
  inAllotment         Boolean?        // Loteamento?
  streetPaving        String?         // Asfalto | Lajota | Paralelepípedo | Terra

  // Comercial específico
  commercialType      String?         // Térrea | Aérea

  // Compartilhamento e Apresentação Pública (Fase 5.3)
  isPublic                 Boolean         @default(false)
  publicId                 String?         @unique
  publishedAt              DateTime?
  publicLocationPrecision  String          @default("APPROXIMATE") // HIDDEN | APPROXIMATE | EXACT

  // Transição segura de autorização (Fase 1 / Ponto 20 / Etapa 1.4)
  // Identifica imóveis existentes antes da ativação da regra de autorização
  legacyExemptFromAuthorization Boolean @default(false)

  // Vínculos da Fase 2 (Bloco 05)
  physicalPropertyId String?
  physicalProperty   PhysicalProperty? @relation("PhysicalPropertyListings", fields: [physicalPropertyId], references: [id], onDelete: SetNull)
  
  buildingId         String?
  building           Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  
  isPrimaryListing   Boolean           @default(false)
  listingSlot        Int?              // 1, 2 ou 3

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  images        PropertyImage[]
  matches       Match[]
  shares        PropertyShare[]
  authorizations PropertyAuthorization[]
  priceRevisions PriceRevisionRequest[]  @relation("PropertyPriceRevisions")

  @@index([physicalPropertyId, status])
  @@index([physicalPropertyId, userId, status])
  @@index([buildingId, status])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  isCover    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Search {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation("CreatedSearches", fields: [userId], references: [id], onDelete: Cascade)
  responsibleBrokerId   String?
  responsibleBroker     User?     @relation("ResponsibleSearches", fields: [responsibleBrokerId], references: [id], onDelete: SetNull)
  clientId              String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  purpose            String    // Venda, Locação
  propertyTypes      String    // JSON array stored as string: ["Apartamento", "Casa"]
  cities             String    // JSON array stored as string: ["Criciúma"]
  neighborhoods      String    // JSON array stored as string: ["Centro", "Comerciário"]
  minPrice           Float?
  maxPrice           Float
  minBedrooms        Int       @default(0)
  minSuites          Int       @default(0)
  minParkingSpaces   Int       @default(0)
  minArea            Float?
  
  // Raio geográfico opcional (retrocompatibilidade)
  referenceAddress   String?
  referenceLatitude  Float?
  referenceLongitude Float?
  maxRadiusKm        Float?

  // Busca geográfica por Ponto + Raio (Fase 5.2) e Tempo de Carro (Fase 5.2.1)
  locationStrategy      String?   @default("NEIGHBORHOODS") // "NEIGHBORHOODS" | "RADIUS" | "TRAVEL_TIME"
  searchLatitude        Float?
  searchLongitude       Float?
  searchRadiusMeters    Float?
  maxTravelTimeMinutes  Int?
  travelMode            String?   @default("DRIVING") // DRIVING

  // Semântica de dormitórios e banheiros (Fase 5.0.1)
  minOtherBedrooms   Int?
  minOtherBathrooms  Int?
  minCoveredParkingSpaces   Int?
  minUncoveredParkingSpaces Int?
  minSocialBathrooms        Int?
  minLavabos                Int?
  minBuiltArea              Float?

  // Terreno / Área documental do terreno
  minLandArea        Float?

  // Preferências tri-state: "INDIFERENTE" | "DESEJAVEL" | "NECESSARIO"
  acceptsExchangePref String?         @default("INDIFERENTE")
  isRegisteredPref    String?         @default("INDIFERENTE")
  poolPref            String?         @default("INDIFERENTE")
  gymPref             String?         @default("INDIFERENTE")
  barbecuePref        String?         @default("INDIFERENTE")
  partyHallPref       String?         @default("INDIFERENTE")
  elevatorPref        String?         @default("INDIFERENTE")
  petSpacePref        String?         @default("INDIFERENTE")
  penthousePref       String?         @default("INDIFERENTE")
  cornerPref          String?         @default("INDIFERENTE")
  gatedCommunityPref  String?         @default("INDIFERENTE")
  allotmentPref       String?         @default("INDIFERENTE")
  
  // Preferências de valores / seleção
  furniturePref       String?         @default("INDIFERENTE") // INDIFERENTE | COMPLETA | SEMI | SEM_MOBILIA
  streetPavingPref    String?         @default("INDIFERENTE") // INDIFERENTE | ASFALTO | LAJOTA | PARALELEPIPEDO | TERRA
  commercialTypePref  String?         @default("INDIFERENTE") // INDIFERENTE | TERREA | AEREA
  customPreferences   String?         // JSON complementar extensível

  notes              String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  matches            Match[]
}

model Match {
  id          String    @id @default(cuid())
  searchId    String
  search      Search    @relation(fields: [searchId], references: [id], onDelete: Cascade)
  offerType   String    @default("PROPERTY") // "PROPERTY" | "TYPOLOGY"
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  typologyId  String?
  typology    Typology? @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  score       Int       // 0 a 100
  explanation String    // JSON string with detailed breakdown
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([searchId])
  @@index([propertyId])
  @@index([typologyId])
}

model Development {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation("CreatedDevelopments", fields: [userId], references: [id], onDelete: Cascade)
  responsibleBrokerId   String?
  responsibleBroker     User?               @relation("ResponsibleDevelopments", fields: [responsibleBrokerId], references: [id], onDelete: SetNull)
  name                  String              // Nome do empreendimento
  developer             String              // Construtora (texto legado mantido para retrocompatibilidade)
  
  // Vínculo Institucional com a Construtora (Bloco 6 / 6A)
  companyId             String?
  company               Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  // Tipologia e Escala do Projeto (Bloco 6 / 6A)
  projectType           String?             @default("VERTICAL") // "VERTICAL" | "HORIZONTAL" | "MISTO" | "LOTEAMENTO"
  totalTowers           Int?                // Quantidade total de torres/quadras
  totalUnits            Int?                // Quantidade total de unidades autônomas
  
  stage                 String              // Lançamento, Na planta, Em construção, Próximo da entrega
  deliveryDate          String?             // Previsão de entrega (ex: Março/2028)
  deliveryYear          Int?                // Ano de entrega para filtros numéricos
  deliveryMonth         Int?                // Mês de entrega (1-12)
  indexCorrection       String?             // Correção monetária (ex: "CUB/SC", "INCC-M", "IGP-M")
  
  status                String              @default("Ativo") // Ativo, Inativo
  description           String?             // Descrição curta
  internalNotes         String?             // Observações internas do corretor/admin

  // Localização
  address               String?
  number                String?
  complement            String?
  neighborhood          String?
  city                  String?
  state                 String?
  zipcode               String?
  latitude              Float?
  longitude             Float?

  // Características compartilhadas do condomínio / empreendimento (Fase 5.0.1)
  hasPool               Boolean?      // Piscina compartilhada
  hasGym                Boolean?      // Academia compartilhada
  hasPartyHall          Boolean?      // Salão de festas compartilhado
  hasPetSpace           Boolean?      // Espaço pet compartilhado
  hasElevator           Boolean?      // Elevadores nas torres
  hasDirectInstallments Boolean?      // Parcelamento próprio com a construtora

  // Convergência com Cadastro Predial Físico (Bloco 6 / Ponto 24)
  buildingId            String?
  building              Building?           @relation("BuildingDevelopment", fields: [buildingId], references: [id], onDelete: SetNull)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  images                DevelopmentImage[]
  typologies            Typology[]
  contacts              DevelopmentContact[]
  blocks                DevelopmentBlock[]

  @@index([companyId])
  @@index([buildingId])
  @@index([status])
  @@index([stage])
  @@index([projectType])
}

// ==============================================================================
// Construtoras e Incorporadoras (Bloco 6 / Ponto 3)
// Cadastro administrativo centralizado de empresas do mercado primário
// ==============================================================================
model Company {
  id                String           @id @default(cuid())
  name              String           // Razão social (ex: "Construtora Fontana Ltda")
  tradeName         String           // Nome fantasia (ex: "Fontana")
  cnpj              String?          @unique // CNPJ único quando informado
  stateRegistration String?          // Inscrição Estadual (IE)
  
  // Localização e Endereço Corporativo
  address           String?
  number            String?
  complement        String?
  neighborhood      String?
  city              String           @default("Criciúma")
  state             String           @default("SC")
  zipcode           String?
  
  // Contato Comercial Geral da Empresa
  phone             String?
  whatsapp          String?
  email             String?
  website           String?
  
  // Identidade Visual e Apresentação
  logoUrl           String?
  bannerUrl         String?
  description       String?          @db.Text
  
  // Governança Administrativa
  status            String           @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  displayOrder      Int              @default(0)        // Ordem no carrossel de marcas
  internalNotes     String?          @db.Text           // Anotações administrativas exclusivas
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  createdById       String?
  createdBy         User?            @relation("CreatedCompanies", fields: [createdById], references: [id], onDelete: SetNull)

  developments      Development[]
  contacts          CompanyContact[]

  @@index([status])
  @@index([city, state])
  @@index([tradeName])
  @@index([displayOrder])
}

// ==============================================================================
// Contatos e Gerentes da Construtora (Bloco 6 / Pontos 4 e 5)
// Equipe comercial com níveis de visibilidade (Público, Corretores ou Admin)
// ==============================================================================
model CompanyContact {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name           String               // Nome do profissional
  role           String               // Cargo: "Gerente Geral de Vendas", "Coordenador de Parcerias", etc.
  phone          String?
  whatsapp       String?              // Telefone formatado para link direto wa.me
  email          String?
  photoUrl       String?
  internalNotes  String?              @db.Text // Observações restritas ao ADMIN
  
  // Governança e Visibilidade Granular (Regras 4 e 5)
  // "PUBLIC": visível a visitantes e clientes finais
  // "BROKERS_ONLY": exclusivo para corretores autenticados
  // "ADMIN_ONLY": exclusivo para administradores
  visibility     String               @default("BROKERS_ONLY")
  status         String               @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  displayOrder   Int                  @default(0)
  
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  developments   DevelopmentContact[]

  @@index([companyId, status])
  @@index([visibility])
  @@index([displayOrder])
}

// ==============================================================================
// Associação N:M entre Empreendimentos e Contatos da Construtora (Bloco 6 / Ponto 4)
// Permite que um gerente atenda múltiplos empreendimentos da mesma construtora
// ==============================================================================
model DevelopmentContact {
  id            String         @id @default(cuid())
  developmentId String
  development   Development    @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  contactId     String
  contact       CompanyContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  isPrimary     Boolean        @default(false) // Gerente de referência prioritário do empreendimento
  customRole    String?        // Sobrescrita contextual opcional do cargo para esta obra
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([developmentId, contactId])
  @@index([developmentId])
  @@index([contactId])
}

// ==============================================================================
// Torres, Blocos e Quadras de Empreendimentos (Bloco 6 / Ponto 4)
// Estrutura organizacional para empreendimentos verticais e horizontais
// ==============================================================================
model DevelopmentBlock {
  id            String       @id @default(cuid())
  developmentId String
  development   Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  
  name          String       // ex: "Torre A - Cristal", "Torre Sul", "Quadra 04"
  blockType     String       @default("TOWER") // "TOWER" | "QUADRA" | "BLOCO"
  totalFloors   Int?         // Quantidade de pavimentos (se vertical)
  unitsPerFloor Int?         // Unidades por pavimento (se vertical)
  displayOrder  Int          @default(0)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([developmentId, name])
  @@index([developmentId])
  @@index([displayOrder])
}

model DevelopmentImage {
  id            String       @id @default(cuid())
  developmentId String
  development   Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  url           String
  isCover       Boolean      @default(false)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
}

model Typology {
  id            String       @id @default(cuid())
  developmentId String
  development   Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name          String       // ex: Tipo A, 2 dorms, Planta 01, Cobertura
  propertyType  String       @default("Apartamento") // Apartamento, Cobertura, Studio, Casa, etc.
  price         Float        // Valor ou valor inicial (a partir de)
  privateArea   Float?       // Área privativa (m²)
  totalArea     Float?       // Área total (m²)
  bedrooms      Int          @default(0)
  suites        Int          @default(0)
  bathrooms     Int          @default(0)
  parkingSpaces Int          @default(0)
  status        String       @default("Disponível") // Disponível, Reservada, Esgotada
  notes         String?      // Observação opcional

  // Semântica e adicionais (Fase 5.0.1)
  otherBedrooms   Int?        // Outros quartos
  otherBathrooms  Int?        // Outros banheiros
  coveredParkingSpaces   Int?
  uncoveredParkingSpaces Int?
  socialBathrooms        Int?
  lavabos                Int?
  builtArea              Float?
  acceptsExchange Boolean?    // Aceita permuta
  exchangeNotes   String?     // Observação da permuta
  hasBarbecue     Boolean?    // Churrasqueira na sacada/unidade
  hasElevator     Boolean?    // Acesso por elevador
  isPenthouse     Boolean?    // Cobertura

  // Compartilhamento e Apresentação Pública (Fase 5.3)
  isPublic                 Boolean     @default(false)
  publicId                 String?     @unique
  publishedAt              DateTime?
  publicLocationPrecision  String      @default("APPROXIMATE") // HIDDEN | APPROXIMATE | EXACT

  matches       Match[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ==============================================================================
// Compartilhamento Individual de Imóveis (Fase 5.4 / Ponto 21)
// Permite que qualquer corretor parceiro gere seu link público exclusivo
// para apresentar um imóvel da rede com sua própria identidade profissional.
// Nota para evolução CRM: atualmente restringe 1 share por par (imóvel, corretor).
// ==============================================================================
model PropertyShare {
  id         String   @id @default(cuid())
  publicId   String   @unique
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  brokerId   String
  broker     User     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, brokerId])
  @@index([propertyId])
  @@index([brokerId])
}

// ==============================================================================
// Configurações Globais da Plataforma (Fase 1 / Ponto 13)
// Armazena configurações dinâmicas gerenciadas pelo Administrador (ex: WhatsApp de suporte)
// ==============================================================================
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}


// ==============================================================================
// Documentos Legais e Versionamento (Fase 1 / Ponto 20)
// Suporta Termos de Uso, Política de Privacidade e Declaração de Autorização
// ==============================================================================
model LegalDocument {
  id            String    @id @default(cuid())
  type          String    // "TERMS_OF_USE" | "PRIVACY_POLICY" | "PROPERTY_AUTHORIZATION"
  version       String    // Ex: "1.0", "1.1"
  title         String
  content       String    @db.Text
  status        String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  publishedAt   DateTime?
  effectiveDate DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  acceptances    LegalAcceptance[]
  authorizations PropertyAuthorization[]

  @@unique([type, version])
  @@index([type, status])
}

// ==============================================================================
// Manifestações Gerais de Usuários aos Documentos Legais (Fase 1 / Ponto 20)
// Registra aceites de Termos de Uso e ciência de Políticas de Privacidade
// ==============================================================================
model LegalAcceptance {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId      String
  document        LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentType    String        // "TERMS_OF_USE" | "PRIVACY_POLICY"
  documentVersion String        // Ex: "1.0"
  action          String        @default("ACCEPTED") // "ACCEPTED" | "ACKNOWLEDGED"
  acceptedAt      DateTime      @default(now())

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
  @@index([documentType, documentVersion])
}

// ==============================================================================
// Declaração de Autorização para Divulgação de Imóvel (Fase 1 / Ponto 20)
// Vínculo individual e auditável entre Corretor, Imóvel e Versão da Declaração
// ==============================================================================
model PropertyAuthorization {
  id               String        @id @default(cuid())
  propertyId       String
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  brokerId         String
  broker           User          @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  documentId       String
  document         LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentVersion  String        // Ex: "1.0"
  status           String        @default("CONFIRMED") // "CONFIRMED" | "REVOKED"
  confirmedAt      DateTime      @default(now())
  revokedAt        DateTime?
  revokedBy        String?       // ID do usuário ou admin responsável pela revogação
  revocationReason String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([propertyId])
  @@index([brokerId])
  @@index([documentId])
  @@index([propertyId, brokerId, status])
}


// ==============================================================================
// Edifícios Residenciais Existentes (Fase 2 / Ponto 25)
// Cadastro compartilhado e colaborativo dos edifícios construídos na cidade
// ==============================================================================
model Building {
  id                  String             @id @default(cuid())
  name                String
  normalizedName      String             // Normalizado para buscas rápidas (ex: "solar das acacias")
  
  // Identificação Mestre e Autoridade de Origem
  externalId          String?            // Código da Prefeitura (ex: "1003", "2541")
  source              String             @default("MANUAL") // "PREFEITURA_CRICIUMA" | "MANUAL" | "IMPORT_XLSX"
  sourceBatch         String?            // Identificador do lote (ex: "CRICIUMA_PREF_2026_01")
  condoType           String?            @default("VERTICAL") // "VERTICAL" | "HORIZONTAL" | "MISTO" | "COMERCIAL"
  alternativeNames    String?            // JSON ou texto com variações de grafia
  blockOrTower        String?            // Identificação de torre/bloco no complexo (ex: "Bloco 02")
  isMultiTowerMember  Boolean            @default(false)    // Indica se faz parte de complexo com múltiplos códigos

  // Localização Predial Compartilhada
  address             String             // Logradouro (ex: "Rua Coronel Pedro Benedet")
  number              String?            // Número predial (ex: "350")
  neighborhood        String?            // Bairro
  city                String             @default("Criciúma")
  state               String             @default("SC")
  zipcode             String?
  latitude            Float?
  longitude           Float?
  geoValidationStatus String             @default("UNVERIFIED") // UNVERIFIED | APPROXIMATE | CONFIRMED | MANUAL_OVERRIDE
  geoConfidence       Float?
  
  // Estrutura do Edifício
  totalFloors         Int?               // Quantidade de pavimentos
  unitsPerFloor       Int?               // Unidades por andar
  towers              String?            // JSON: ["Torre A", "Torre B"] ou null
  
  // Registro / Matrícula-mãe do terreno do edifício (se informada)
  landRegistryNumber  String?
  landRegistryOffice  String?            // Comarca / Cartório de Registro
  
  // Comodidades Compartilhadas do Edifício
  hasPool             Boolean?
  hasGym              Boolean?
  hasPartyHall        Boolean?
  hasElevator         Boolean?
  hasPetSpace         Boolean?
  hasBarbecue         Boolean?
  coverImageUrl       String?
  
  // Governança Colaborativa e Auditoria
  dataValidationStatus String            @default("VALIDATED") // VALIDATED | PENDING_REVIEW | SUSPICIOUS | REJECTED
  status              String             @default("ACTIVE") // ACTIVE | PENDING_REVIEW | MERGED | INACTIVE
  verifiedByAdmin     Boolean            @default(false)
  createdById         String?
  createdBy           User?              @relation("CreatedBuildings", fields: [createdById], references: [id], onDelete: SetNull)
  
  // Validação Colaborativa de Localização (Etapa H)
  geoContributorsCount Int               @default(0)
  geoLastConfirmedAt   DateTime?
  geoAdminDecidedAt    DateTime?
  geoAdminDecidedById  String?
  geoAdminDecidedBy    User?             @relation("BuildingGeoAdminDecider", fields: [geoAdminDecidedById], references: [id], onDelete: SetNull)

  // Delimitação Coletiva do Terreno (Etapa J.2.C)
  boundary                    String?            // GeoJSON do polígono coletivo do terreno do edifício (cache)
  boundaryArea                Float?             // Área calculada em m² do terreno coletivo
  boundaryValidationStatus    String             @default("UNVERIFIED") // UNVERIFIED | SINGLE_BROKER_CONFIRMED | MULTI_BROKER_CONFIRMED | ADMIN_VALIDATED | DIVERGENT
  boundaryConfidence          Float?             // Índice de confiança (0.0 a 1.0)
  boundaryContributorsCount   Int                @default(0)
  boundaryLastConfirmedAt     DateTime?
  boundaryCreatedById         String?
  boundaryCreatedBy           User?              @relation("BuildingBoundaryCreatedBy", fields: [boundaryCreatedById], references: [id], onDelete: SetNull)
  boundarySource              String             @default("BROKER_DRAWN") // BROKER_DRAWN | PREFEITURA_CADASTRE | ADMIN_OVERRIDE

  // Vinculação a Lote Cadastral Independente (Etapa J.2.C.2)
  landParcelId                String?
  landParcel                  LandParcel?        @relation("BuildingPrimaryParcel", fields: [landParcelId], references: [id], onDelete: SetNull)
  landParcels                 BuildingLandParcel[]

  // Fotografia Principal da Fachada (Etapa J.2.C)
  coverImageValidationStatus  String             @default("UNVERIFIED") // UNVERIFIED | BROKER_UPLOADED | ADMIN_VALIDATED | DISPUTED
  coverImageUploadedById      String?
  coverImageUploadedBy        User?              @relation("BuildingCoverImageUploadedBy", fields: [coverImageUploadedById], references: [id], onDelete: SetNull)
  coverImageSource            String             @default("BROKER_UPLOAD") // BROKER_UPLOAD | ADMIN_UPLOAD | EXTERNAL_IMPORT
  coverImageUpdatedAt         DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  units               BuildingUnit[]
  physicalProperties  PhysicalProperty[]
  properties          Property[]
  locationContributions BuildingLocationContribution[]
  boundaryContributions BuildingBoundaryContribution[]
  imageContributions    BuildingImageContribution[]
  developments          Development[]                  @relation("BuildingDevelopment")

  @@unique([city, source, externalId], name: "city_source_external_unique")
  @@index([city, neighborhood])
  @@index([latitude, longitude])
  @@index([normalizedName])
  @@index([source, dataValidationStatus])
  @@index([sourceBatch])
  @@index([landParcelId])
}

// ==============================================================================
// Contribuições Colaborativas de Localização de Edifícios (Etapa H)
// Registra o histórico individual de propostas, confirmações e divergências de pins
// ==============================================================================
model BuildingLocationContribution {
  id                   String    @id @default(cuid())
  buildingId           String
  building             Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  brokerId             String
  broker               User      @relation("BrokerLocationContributions", fields: [brokerId], references: [id], onDelete: Cascade)
  
  latitude             Float
  longitude            Float
  
  // "CONFIRMED_EXISTING" | "PROPOSED_NEW" | "PROPOSED_ADJUSTMENT" | "SKIPPED"
  contributionType     String
  
  // "PENDING" | "ACCEPTED" | "SUPERSEDED" | "REJECTED" | "FLAGGED_DIVERGENT"
  status               String    @default("PENDING")
  
  // "BROKER_MAP_PIN" | "APPROXIMATE_GEOCODE" | "ADMIN_OVERRIDE"
  source               String    @default("BROKER_MAP_PIN")
  
  distanceFromCurrent  Float?    // Distância em metros da coordenada anterior/estimada
  decisionNotes        String?   @db.Text
  decidedById          String?
  decidedBy            User?     @relation("DecidedLocationContributions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt            DateTime?
  
  // Estrutura preparada para pontuação futura (Gamificação dormente)
  pointsAwarded        Int       @default(0)
  pointsEligible       Boolean   @default(true)
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([buildingId, status])
  @@index([brokerId, createdAt])
  @@index([status])
}

// ==============================================================================
// Contribuições e Propostas de Delimitação do Terreno do Edifício (Etapa J.2.C)
// ==============================================================================
model BuildingBoundaryContribution {
  id                   String    @id @default(cuid())
  buildingId           String
  building             Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  brokerId             String
  broker               User      @relation("BrokerBoundaryContributions", fields: [brokerId], references: [id], onDelete: Cascade)
  
  boundary             String    // GeoJSON do polígono proposto
  boundaryArea         Float?    // Área calculada em m²
  
  // "INITIAL_DELIMITATION" | "CONFIRMED_EXISTING" | "PROPOSED_REVISION"
  contributionType     String
  
  // "PENDING" | "ACCEPTED" | "SUPERSEDED" | "REJECTED" | "FLAGGED_DIVERGENT"
  status               String    @default("PENDING")
  
  source               String    @default("BROKER_DRAWN")
  justification        String?   // Justificativa caso seja proposta de alteração
  decisionNotes        String?   @db.Text
  decidedById          String?
  decidedBy            User?     @relation("DecidedBoundaryContributions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt            DateTime?

  // Lote cadastral associado à contribuição (Etapa J.2.C.2)
  landParcelId         String?
  landParcel           LandParcel? @relation(fields: [landParcelId], references: [id], onDelete: SetNull)
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([buildingId, status])
  @@index([brokerId, createdAt])
  @@index([landParcelId])
  @@index([status])
}

// ==============================================================================
// Lotes e Terrenos Cadastrais (Etapa J.2.C.2 - Base Territorial Independente)
// ==============================================================================
model LandParcel {
  id                   String                 @id @default(cuid())
  code                 String?                // Inscrição municipal / Código cadastral oficial (IPTU / SQL)
  externalId           String?                // Identificador em base cadastral externa (SIG / GeoCriciúma)
  source               String                 @default("BROKER_DRAWN") // MUNICIPAL_CADASTRE | BROKER_DRAWN | ADMIN_VALIDATED | GEO_IMPORT
  originType           String                 @default("MANUAL_DRAW") // MANUAL_DRAW | CADASTRE_IMPORT | SATELLITE_SURVEY | TOPOGRAPHIC

  // Geometria Interoperável GeoJSON (Polygon / MultiPolygon)
  boundary             String                 @db.Text
  boundaryArea         Float                  // Área calculada em m²

  // Coordenadas do Centróide e Caixa Delimitadora (Bounding Box) para Busca Espacial
  centroidLat          Float?
  centroidLng          Float?
  bboxMinLat           Float?
  bboxMaxLat           Float?
  bboxMinLng           Float?
  bboxMaxLng           Float?

  // Endereço e Referência Cadastral
  address              String?
  number               String?
  neighborhood         String?
  city                 String                 @default("Criciúma")
  state                String                 @default("SC")
  zipcode              String?

  // Governança e Validação
  validationStatus     String                 @default("UNVERIFIED") // UNVERIFIED | SINGLE_BROKER_CONFIRMED | MULTI_BROKER_CONFIRMED | ADMIN_VALIDATED | OFFICIAL_CADASTRE | DIVERGENT
  confidence           Float                  @default(0.0)
  contributorsCount    Int                    @default(0)
  lastConfirmedAt      DateTime?

  createdById          String?
  createdBy            User?                  @relation("LandParcelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  // Relacionamentos
  buildings            BuildingLandParcel[]
  primaryForBuildings  Building[]             @relation("BuildingPrimaryParcel")
  boundaryContributions BuildingBoundaryContribution[]

  @@index([city, neighborhood])
  @@index([code])
  @@index([source, externalId])
  @@index([validationStatus])
  @@index([bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng])
}

// ==============================================================================
// Associação N:M entre Edifícios e Lotes Cadastrais
// ==============================================================================
model BuildingLandParcel {
  id                   String                 @id @default(cuid())
  buildingId           String
  building             Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  landParcelId         String
  landParcel           LandParcel             @relation(fields: [landParcelId], references: [id], onDelete: Cascade)

  isPrimary            Boolean                @default(true)
  notes                String?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([buildingId, landParcelId])
  @@index([buildingId])
  @@index([landParcelId])
}

// ==============================================================================
// Contribuições e Propostas de Imagem da Fachada do Edifício (Etapa J.2.C)
// ==============================================================================
model BuildingImageContribution {
  id                   String    @id @default(cuid())
  buildingId           String
  building             Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  brokerId             String
  broker               User      @relation("BrokerImageContributions", fields: [brokerId], references: [id], onDelete: Cascade)
  
  imageUrl             String
  
  // "INITIAL_COVER" | "PROPOSED_SUBSTITUTION"
  contributionType     String
  
  // "PENDING" | "ACCEPTED" | "SUPERSEDED" | "REJECTED"
  status               String    @default("PENDING")
  
  source               String    @default("BROKER_UPLOAD")
  justification        String?   // Justificativa caso seja proposta de substituição
  decisionNotes        String?   @db.Text
  decidedById          String?
  decidedBy            User?     @relation("DecidedImageContributions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt            DateTime?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([buildingId, status])
  @@index([brokerId, createdAt])
  @@index([status])
}

// ==============================================================================
// Unidades de Apartamentos em Edifícios (Fase 2 / Ponto 25)
// Identificação individual das unidades/apartamentos dentro de cada edifício
// ==============================================================================
model BuildingUnit {
  id                 String            @id @default(cuid())
  buildingId         String
  building           Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  
  unitNumber         String            // Ex: "101", "302B", "Cobertura 01"
  normalizedUnit     String            // Para unicidade (ex: "101", "302b")
  tower              String?           // Ex: "Torre A" ou null
  floor              Int?              // Andar
  
  // Matrícula individualizada da unidade autônoma (se houver)
  unitRegistryNumber String?
  
  // Características Estruturais de Referência da Unidade
  bedrooms           Int?
  suites             Int?
  bathrooms          Int?
  parkingSpaces      Int?
  privateArea        Float?
  totalArea          Float?
  
  // Vínculo 1:1 com a identidade física
  physicalPropertyId String?           @unique
  physicalProperty   PhysicalProperty? @relation(fields: [physicalPropertyId], references: [id], onDelete: SetNull)
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([buildingId, tower, normalizedUnit], name: "building_tower_unit_unique")
  @@index([buildingId, floor])
}

// ==============================================================================
// Identidade Física Compartilhada do Imóvel (Fase 2 / Pontos 2 e 25)
// Ponto de convergência para qualquer imóvel real (casa, terreno ou apto)
// ==============================================================================
model PhysicalProperty {
  id                  String              @id @default(cuid())
  propertyType        String              // "Apartamento", "Casa", "Terreno", "Comercial", etc.
  
  // Vínculo com Edifício e Unidade (se for apartamento de condomínio)
  buildingId          String?
  building            Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit                BuildingUnit?
  
  // Localização Física do Imóvel
  address             String?
  number              String?
  complement          String?
  neighborhood        String?
  city                String              @default("Criciúma")
  state               String              @default("SC")
  zipcode             String?
  latitude            Float?
  longitude           Float?
  
  // Dados Documentais do Registro de Imóveis (Sensíveis)
  registryNumber      String?             // Número da matrícula no Cartório de RI
  registryOffice      String?             // Cartório de RI / Comarca
  registryType        String?             // "INDIVIDUAL" | "GLEBA_MAE" | "EM_APROVACAO" | "OUTRO"
  
  // Geometria (Casas e Terrenos)
  boundary            String?             // GeoJSON
  boundaryArea        Float?              // Área calculada auxiliar (não comercial)
  
  // Metragens Físicas de Referência
  landArea            Float?
  builtArea           Float?
  privateArea         Float?
  totalArea           Float?
  
  // Gestão de Capacidade (Ponto 2: máx 3 anúncios ativos)
  activeListingsCount Int                 @default(0)
  primaryListingId    String?             // ID do anúncio Property atualmente principal
  
  // Preço Único Compartilhado (Fase 2 / Ponto 2 / F2.B05.3B)
  sharedPrice         Decimal?            @db.Decimal(15, 2)
  priceUpdatedAt      DateTime?
  priceUpdatedById    String?
  priceUpdatedBy      User?               @relation("PhysicalPropertyPriceUpdater", fields: [priceUpdatedById], references: [id], onDelete: SetNull)
  
  status              String              @default("ACTIVE") // ACTIVE | ARCHIVED | DISPUTED
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  listings            Property[]          @relation("PhysicalPropertyListings")
  waitlist            PropertyWaitlist[]
  disputes            PropertyDispute[]
  priceHistory        PhysicalPropertyPriceHistory[]
  priceRevisionRequests PriceRevisionRequest[]

  @@index([city, neighborhood])
  @@index([latitude, longitude])
  @@index([registryNumber])
  @@index([status, activeListingsCount])
  @@index([sharedPrice])
}

// ==============================================================================
// Lista de Espera de Corretores (Fase 2 / Ponto 2)
// Gerencia a fila cronológica de corretores interessados a partir da 4ª vaga
// ==============================================================================
model PropertyWaitlist {
  id                 String           @id @default(cuid())
  physicalPropertyId String
  physicalProperty   PhysicalProperty @relation(fields: [physicalPropertyId], references: [id], onDelete: Cascade)
  brokerId           String
  broker             User             @relation("BrokerWaitlists", fields: [brokerId], references: [id], onDelete: Cascade)
  
  position           Int              // Ordem cronológica na fila (1, 2, 3...)
  status             String           @default("WAITING") // WAITING | NOTIFIED | CLAIMED | EXPIRED | CANCELLED
  
  draftPropertyId    String?          // ID do Property salvo em rascunho/inativo
  
  notifiedAt         DateTime?        // Momento em que a vaga foi liberada
  expiresAt          DateTime?        // Prazo limite para confirmação (48 horas úteis)
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([physicalPropertyId, brokerId])
  @@index([physicalPropertyId, status, position])
}

// ==============================================================================
// Contestações Administrativas e Exclusividade (Fase 2 / Ponto 2)
// Canal seguro para resolução de divergências e alegações de exclusividade
// ==============================================================================
model PropertyDispute {
  id                 String           @id @default(cuid())
  physicalPropertyId String
  physicalProperty   PhysicalProperty @relation(fields: [physicalPropertyId], references: [id], onDelete: Cascade)
  claimantBrokerId   String
  claimantBroker     User             @relation("BrokerDisputes", fields: [claimantBrokerId], references: [id], onDelete: Cascade)
  
  type               String           // "EXCLUSIVITY_CLAIM" | "IDENTITY_MISMATCH" | "FRAUDULENT_LISTING" | "UNAUTHORIZED_LISTING" | "OTHER"
  description        String           @db.Text
  documentProofUrl   String?          // Comprovante / contrato anexado
  
  status             String           @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED
  adminNotes         String?          @db.Text
  resolvedById       String?          // ID do ADMIN que julgou
  resolvedAt         DateTime?
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  priceRevisions     PriceRevisionRequest[]

  @@index([physicalPropertyId, status])
  @@index([claimantBrokerId, status])
}

// ==============================================================================
// Histórico de Preço do Imóvel Físico (Fase 2 / Ponto 2 / F2.B05.3B)
// Registra todas as alterações de preço compartilhado para auditoria
// ==============================================================================
model PhysicalPropertyPriceHistory {
  id                 String           @id @default(cuid())
  physicalPropertyId String
  physicalProperty   PhysicalProperty @relation(fields: [physicalPropertyId], references: [id], onDelete: Cascade)
  
  oldPrice           Decimal?         @db.Decimal(15, 2)
  newPrice           Decimal          @db.Decimal(15, 2)
  changedById        String
  changedBy          User             @relation("PriceHistoryAuthor", fields: [changedById], references: [id], onDelete: Restrict)
  
  reason             String?          @db.Text
  source             String           @default("PRIMARY_BROKER") // "PRIMARY_BROKER" | "REVISION_ACCEPTED" | "ADMIN_ADJUDICATION" | "INITIAL_LISTING"
  revisionRequestId  String?          // ID da solicitação de revisão que originou a alteração, quando aplicável
  
  createdAt          DateTime         @default(now())

  @@index([physicalPropertyId, createdAt])
  @@index([changedById])
}

// ==============================================================================
// Solicitações de Revisão de Preço (Fase 2 / Ponto 2 / F2.B05.3B)
// Canal para corretores secundários proporem alterações de preço ao corretor principal
// ==============================================================================
model PriceRevisionRequest {
  id                 String           @id @default(cuid())
  physicalPropertyId String
  physicalProperty   PhysicalProperty @relation(fields: [physicalPropertyId], references: [id], onDelete: Cascade)
  
  requestingBrokerId String
  requestingBroker   User             @relation("PriceRevisionsRequested", fields: [requestingBrokerId], references: [id], onDelete: Cascade)
  
  propertyId         String?          // Anúncio associado do corretor solicitante, quando aplicável
  property           Property?        @relation("PropertyPriceRevisions", fields: [propertyId], references: [id], onDelete: SetNull)
  
  currentPrice       Decimal          @db.Decimal(15, 2)
  suggestedPrice     Decimal          @db.Decimal(15, 2)
  justification      String           @db.Text
  documentProofUrl   String?          // Comprovante / autorização atualizada anexada
  
  status             String           @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | ESCALATED
  
  decidedById        String?          // Corretor principal ou administrador que decidiu
  decidedBy          User?            @relation("PriceRevisionsDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  decisionReason     String?          @db.Text
  
  disputeId          String?          // Vínculo com PropertyDispute caso seja escalado para a administração
  dispute            PropertyDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([physicalPropertyId, status])
  @@index([requestingBrokerId, status])
  @@index([decidedById, status])
  @@index([propertyId])
  @@index([disputeId])
}
