# Banco de dados
# Para desenvolvimento local simplificado (SQLite):
DATABASE_URL="file:./dev.db"
# Para produção / Supabase (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/areanobre?schema=public"

# GeoBase Mapas API Key (usado estritamente no backend)
GEOBASE_API_KEY=""

# Autenticação e Sessão
AUTH_SECRET="area-nobre-secret-key-development-2026"
NEXT_PUBLIC_APP_NAME="Área Nobre"

# Fase 4.3 — Provedores de Basemap (Mapa Vetorial e Imagem de Satélite)
# O provedor padrão é 'esri' (Esri World Imagery / ArcGIS Online), que possui alta resolução
# no Brasil (inclusive Criciúma), funciona diretamente sem chave para protótipo/desenvolvimento web.
NEXT_PUBLIC_SATELLITE_PROVIDER="esri"
# Opcional: Se desejar utilizar Mapbox Satellite no futuro:
# NEXT_PUBLIC_SATELLITE_PROVIDER="mapbox"
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.seu_token_aqui"
# Opcional: Provedor WMS/XYZ personalizado:
# NEXT_PUBLIC_SATELLITE_PROVIDER="custom"
# NEXT_PUBLIC_CUSTOM_SATELLITE_URL="https://seu-servidor-tiles/{z}/{x}/{y}.jpg"
