# ==============================================================================
# ÁREA NOBRE — VARIÁVEIS DE AMBIENTE (MODELO EXEMPLO)
# NUNCA insira senhas ou chaves reais neste arquivo.
# No ambiente local, copie este arquivo para .env.local (ignorado pelo Git).
# Na Vercel, configure diretamente em Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL Supabase)
# ------------------------------------------------------------------------------
# URL para Runtime / Serverless (Transaction Pooler - porta 6543 do Supavisor):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL para Migrations Prisma (Session Pooler porta 5432 ou Direct Connection, conforme oferecido pelo painel do Supabase):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Para desenvolvimento local offline alternativo (SQLite legado):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (Object Storage para fotos, mídias e logos)
# ------------------------------------------------------------------------------
# URL do projeto Supabase:
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Credencial secreta moderna exclusivamente server-side (Secret Key - sb_secret_...):
SUPABASE_SECRET_KEY="sb_secret_..."

# Nome do bucket de mídia pública (padrão: area-nobre-media):
SUPABASE_STORAGE_BUCKET="area-nobre-media"

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO E SESSÃO (JWT + Cookies Seguros)
# ------------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura HMAC-SHA256 da sessão:
AUTH_SECRET="chave-secreta-de-alta-entropia-gerada-aleatoriamente-minimo-32-caracteres"

# ------------------------------------------------------------------------------
# 4. URLs PÚBLICAS & OPEN GRAPH
# ------------------------------------------------------------------------------
# URL canônica HTTPS da aplicação (necessária para Open Graph, WhatsApp e links compartilháveis):
# Exemplo Homologação Vercel: https://area-nobre-homolog.vercel.app
# Exemplo Futura Produção: https://app.areanobre.com.br
APP_PUBLIC_URL="https://seu-deploy.vercel.app"

# Nome público da aplicação:
NEXT_PUBLIC_APP_NAME="Área Nobre"

# ------------------------------------------------------------------------------
# 5. GEOBASE MAPAS (Geocodificação, Rotas e Território)
# ------------------------------------------------------------------------------
# Chave da API GeoBase (executada estritamente server-side no backend da Área Nobre):
GEOBASE_API_KEY=""

# ------------------------------------------------------------------------------
# 6. MAPAS E IMAGENS DE SATÉLITE (Basemaps)
# ------------------------------------------------------------------------------
# Provedor de satélite: 'esri' (padrão integrado de alta resolução) ou 'mapbox' / 'custom'
NEXT_PUBLIC_SATELLITE_PROVIDER="esri"
# NEXT_PUBLIC_MAPBOX_TOKEN=""
